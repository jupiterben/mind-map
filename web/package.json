{
  "name": "thoughts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "serve": "vite",
    "build": "vite build && node ../copy.js",
    "preview": "vite preview",
    "lint": "eslint src --ext .vue,.js,.ts,.tsx,.cjs,.mjs",
    "buildLibrary": "node ./scripts/updateVersion.js && vite build --mode library && esbuild ../simple-mind-map/full.ts --bundle --external:buffer --format=esm --outfile=../simple-mind-map/dist/simpleMindMap.esm.js && esbuild ../simple-mind-map/full.ts --bundle --minify --external:buffer --format=esm --outfile=../simple-mind-map/dist/simpleMindMap.esm.min.js",
    "format": "prettier --write src/* src/*/* src/*/*/* src/*/*/*/*",
    "createNodeImageList": "node ./scripts/createNodeImageList.js",
    "ai:serve": "node ./scripts/ai.js",
    "typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@toast-ui/editor": "^3.1.5",
    "axios": "^1.7.9",
    "codemirror": "^5.65.16",
    "dayjs": "^1.11.19",
    "element-plus": "^2.8.4",
    "highlight.js": "^10.7.3",
    "katex": "^0.16.9",
    "mitt": "^3.0.1",
    "simple-mind-map": "file:../simple-mind-map",
    "simple-mind-map-plugin-themes": "^1.0.0",
    "v-viewer": "^3.0.23",
    "viewerjs": "^1.11.6",
    "vue": "^3.5.13",
    "vue-i18n": "^9.14.2",
    "vue-router": "^4.4.5",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/node": "^25.2.3",
    "@vitejs/plugin-vue": "^5.2.1",
    "chokidar": "^3.5.3",
    "esbuild": "^0.17.15",
    "express": "^4.21.2",
    "less": "^4.2.0",
    "markdown-it": "^13.0.1",
    "markdown-it-checkbox": "^1.1.0",
    "parchment": "^3.0.0",
    "pinia": "^2.2.6",
    "prettier": "^1.19.1",
    "quill-delta": "^5.1.0",
    "typescript": "^5.9.3",
    "vconsole": "^3.15.1",
    "vite": "^6.0.3",
    "vite-plugin-node-polyfills": "^0.25.0",
    "vue-tsc": "^3.2.4"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead"
  ]
}